# Supabase Configuration
# Required for database and vector storage
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# SharePoint / Microsoft Graph Credentials
# Required for OneDrive integration
ONEDRIVE_CLIENT_ID=your-client-id
ONEDRIVE_CLIENT_SECRET=your-client-secret
ONEDRIVE_TENANT_ID=your-tenant-id
ONEDRIVE_USER_ID=your-user-id@domain.com
ONEDRIVE_FOLDER_NAME=rag_documents

# Optional: Microsoft Graph Base URLs (Defaults are used if not set)
# MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# MS_LOGIN_BASE_URL=https://login.microsoftonline.com

# Ingestion & Model Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,md

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
# API_BASE_URL=http://localhost:8000
